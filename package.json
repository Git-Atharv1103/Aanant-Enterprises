{
  "name": "aanant-enterprises",
  "private": true,
  "version": "1.0.0",
  "description": "Corporate website for Aanant Enterprises — Infinite Solutions",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"API,WEB\" -c \"magenta,blue\" \"node server/server.js\" \"vite\"",
    "dev:web": "vite",
    "server": "node server/server.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server/server.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "lucide-react": "^1.61.0",
    "nodemailer": "^10.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.88.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
