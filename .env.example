# Aanant Enterprises - Environment Configuration Template

# Server Port
PORT=5000

# Frontend API URL (leave empty in production if served together, or specify during local dev)
VITE_API_URL=http://localhost:5000

# Email Delivery Configuration (Optional - Enquiries are automatically stored safely in server/data/enquiries.json)
# Configure these if you wish incoming enquiries to be forwarded directly to aanantenterprises03@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=aanantenterprises03@gmail.com
SMTP_PASS=your_app_password_here
NOTIFICATION_EMAIL=aanantenterprises03@gmail.com
